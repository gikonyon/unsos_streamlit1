# Copy this file to .streamlit/secrets.toml and fill in real values.
# NEVER commit the real secrets.toml to GitHub — add it to .gitignore.
#
# For Streamlit Community Cloud: paste these same keys/values into
# your app's "Secrets" settings in the dashboard instead of a file.

[graph]
tenant_id = "YOUR_UN_ENTRA_ID_TENANT_ID"
client_id = "YOUR_APP_REGISTRATION_CLIENT_ID"
client_secret = "YOUR_APP_REGISTRATION_CLIENT_SECRET"
sender_mailbox = "unsos.service@un.org"

# --- How to obtain these values (UN ICT / Exchange admin action) ---
# 1. Register an application in the tenant's Entra ID (Azure AD) —
#    Azure Portal > App registrations > New registration.
# 2. Under API permissions, add Microsoft Graph > Application permissions
#    > Mail.Send, then have an admin grant admin consent for it.
# 3. Under Certificates & secrets, create a new client secret — copy its
#    VALUE (not the secret ID) into client_secret above immediately, it's
#    only shown once.
# 4. Scope the app to ONLY the unsos.service@un.org mailbox using an
#    Application Access Policy in Exchange Online PowerShell, e.g.:
#      New-ApplicationAccessPolicy -AppId <client_id> `
#        -PolicyScopeGroupId unsos.service@un.org `
#        -AccessRight RestrictAccess -Description "Service desk bot"
#    Without this step, an app-only Mail.Send token can send as ANY
#    mailbox in the tenant — do not skip it.
